# App
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://workforceos:workforceos@db:5432/workforceos
POSTGRES_USER=workforceos
POSTGRES_PASSWORD=workforceos
POSTGRES_DB=workforceos

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
