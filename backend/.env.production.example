# Production settings. In production, set these as REAL environment variables in your hosting platform or
# secret manager. Do not keep a .env file with production credentials on disk, and never commit one.
# The server REFUSES TO START in production if any of the security checks in app/config.py fail
# (http:// origins, the app connecting as the database owner, a missing AUDIT_HMAC_KEY, HSTS off).
APP_ENV=production

# The app connects as the RESTRICTED user (data read/write only); migrations use the OWNER.
# See docs/SECURITY.md, "Least-privilege database access". Both passwords: long and random.
DATABASE_URL=postgresql+psycopg://workforceos_app:<long-random-password>@<db-host>:5432/workforceos
MIGRATION_DATABASE_URL=postgresql+psycopg://workforceos:<another-long-random-password>@<db-host>:5432/workforceos

# APP_ENV=production always disables the demo reset endpoint and `seed --reset`, whatever this says.
ENABLE_DEMO_RESET=false

# Authentication (Phase 3)
FRONTEND_ORIGINS=https://workforceos.example.com
PUBLIC_APP_URL=https://workforceos.example.com
REGISTRATION_ENABLED=false        # invitations only, unless you really want open sign-up
# COOKIE_SECURE and PASSWORD_HASH_PROFILE=standard are enforced automatically when APP_ENV=production.

# Security (Phase 4)
AUDIT_HMAC_KEY=<64 hex characters from: python -c "import secrets; print(secrets.token_hex(32))">
# AUDIT_HMAC_OLD_KEYS=<previous keys, comma-separated, only after a rotation>
HSTS_MAX_AGE=31536000             # 1 year; only because the site is served over HTTPS
EXPOSE_API_DOCS=false
LOG_FORMAT=json
LOG_LEVEL=INFO
# Rate limits are kept in each server process's memory. With MORE THAN ONE process/instance, each keeps its own
# counters, so the real limit becomes N x the number below: see docs/SECURITY.md ("shared store").
RATE_LIMIT_READ=300/minute
RATE_LIMIT_WRITE=60/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SENSITIVE=30/hour
RATE_LIMIT_PER_IP=1200/minute
# Start uvicorn with --no-server-header (and --proxy-headers only behind a trusted reverse proxy).
