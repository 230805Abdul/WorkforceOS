# Development settings. Copy to `.env` (cp .env.example .env) and replace the password with the one you chose
# when you created the PostgreSQL user. `.env` is git-ignored: never commit real credentials.
APP_ENV=development

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://workforceos:your_password_here@localhost:5432/workforceos

# Lets "Reset demo data" (website) and `python -m app.seed --reset` wipe the database. Development only.
ENABLE_DEMO_RESET=true

# Zero-install fallback for quick experiments (a single local file) instead of PostgreSQL:
# DATABASE_URL=sqlite:///./workforceos.db

# ---- Phase 3: authentication (see docs/AUTH.md). The defaults below are fine for local development. ----
# Browser origin(s) of the frontend. CORS and the cross-site check only allow these.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Base URL used in password-reset / invitation links.
PUBLIC_APP_URL=http://127.0.0.1:5173
# Anyone can sign up (as "Employee"). false = invitations only.
REGISTRATION_ENABLED=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
REMEMBER_ME_DAYS=30
MAX_SESSIONS_PER_USER=5
# Cookies over HTTPS only. Leave false on http://127.0.0.1; forced on when APP_ENV=production.
COOKIE_SECURE=false

# ---- Phase 4: security (see docs/SECURITY.md). The defaults are fine for local development. ----
# Audit-log signing key. Without it a PUBLIC development key is used (the server warns; production refuses).
# Generate your own:   python -c "import secrets; print(secrets.token_hex(32))"
# AUDIT_HMAC_KEY=
# After rotating, old keys go here (comma-separated) so older records still verify:
# AUDIT_HMAC_OLD_KEYS=

# Least-privilege database access (optional in development, required in production):
# run ./scripts/setup_least_privilege.sh, then use the restricted user for the app and the owner for migrations.
# DATABASE_URL=postgresql+psycopg://workforceos_app:app_password_here@localhost:5432/workforceos
# MIGRATION_DATABASE_URL=postgresql+psycopg://workforceos:your_password_here@localhost:5432/workforceos

# Rate limits, "<count>/<period>" (second, minute, hour, day). Over the limit = HTTP 429 with Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ=300/minute
RATE_LIMIT_WRITE=60/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SENSITIVE=30/hour
RATE_LIMIT_PER_IP=1200/minute

# Request and database limits
MAX_REQUEST_BODY_BYTES=65536
DB_STATEMENT_TIMEOUT_MS=15000
# How recently the password must have been typed for high-impact admin actions ("sudo mode")
REAUTH_MINUTES=10

# Logs: "text" (readable) or "json" (one JSON object per line, for log tools). Passwords/tokens are never logged.
LOG_FORMAT=text
LOG_LEVEL=INFO
# /docs and /redoc (interactive API docs). Defaults: on in development, off in production.
EXPOSE_API_DOCS=true
